# Use the full URL when possible. Otherwise set the event ID.
UTR_EVENT_URL=
UTR_EVENT_ID=
# Exact expected title/name; strongly recommended and required for live mode.
UTR_EVENT_NAME=
# Keep false for interactive authentication. Set true only for unattended checks.
UTR_HEADLESS=false
# Optional Chrome channel (for example: chrome). Bundled Chromium is the default.
UTR_BROWSER_CHANNEL=
UTR_PROFILE_DIR=.playwright/utr-profile
UTR_SCREENSHOT_DIR=screenshots
UTR_LOG_DIR=logs
