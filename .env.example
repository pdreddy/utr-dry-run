# Environment variables override utr.config.json. Use the full URL when possible.
UTR_EVENT_URL=
UTR_EVENT_ID=
# Exact expected title/name; strongly recommended and required for live mode.
UTR_EVENT_NAME=
# Headed mode is the default on every OS. Set true only for unattended checks.
UTR_HEADLESS=false
# How long a headed run waits for legitimate login/MFA (milliseconds).
UTR_LOGIN_TIMEOUT_MS=600000
# Optional Chrome channel (for example: chrome). Bundled Chromium is the default.
UTR_BROWSER_CHANNEL=
# Optional: attach to an already-open, already-authenticated local Chrome.
UTR_CDP_URL=
UTR_PROFILE_DIR=.playwright/utr-profile
UTR_SCREENSHOT_DIR=screenshots
UTR_LOG_DIR=logs
# Optional alternate path; defaults to ./utr.config.json.
UTR_CONFIG=utr.config.json
